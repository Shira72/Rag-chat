# העתיקי את הקובץ הזה ל-.env ומלאי את המפתח.


OPENAI_API_KEY=sk-...

# מודל שעונה על השאלות, ומודל שהופך טקסט לווקטור (אמבדינג).
# אם מחליפים את EMBED_MODEL, צריך לבנות את האינדקס מחדש:
#   python -m app.ingestion.ingest --rebuild
CHAT_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-large

# חיפוש: כמה קטעים מביאים מכל שיטת חיפוש, וכמה מהם נשלחים למודל
TOP_K_VECTOR=15
TOP_K_KEYWORD=10
FINAL_K=8

# סף רלוונטיות (דמיון קוסינוס, 0 עד 1).
# אם הקטע הכי קרוב לשאלה מתחת לסף, עונים "לא מצאתי" בלי לפנות למודל.
# את הערך מכיילים בעזרת eval/run_eval.py
MIN_SIMILARITY=0.30
